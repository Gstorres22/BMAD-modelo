{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Executar extensão BMAD Studio",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}"
      ],
      "outFiles": [
        "${workspaceFolder}/**/*.js"
      ]
    },
    {
      "name": "Standalone (node)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/standalone.js",
      "args": [
        "--open"
      ],
      "console": "integratedTerminal"
    }
  ]
}
